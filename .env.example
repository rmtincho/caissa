# ---------------------------------------------------------------------------
# Caissa — formulario de contacto (Resend)
#
# 1. Copiá este archivo a `.env.local`  ->  cp .env.example .env.local
# 2. Completá las variables de abajo.
# 3. Listo: el formulario de /#contacto enviará los emails automáticamente.
#
# En producción (Vercel) cargá estas mismas variables en
# Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# API key de Resend. Obtenela en https://resend.com/api-keys
# (empieza con "re_"). Es obligatoria.
RESEND_API_KEY=re_*********************

# Remitente de los emails. DEBE usar un dominio verificado en Resend
# (https://resend.com/domains). Formato: "Nombre <direccion@tudominio.com>".
# Mientras no verifiques el dominio, podés probar con "onboarding@resend.dev",
# pero solo te llegarán a vos (al email de tu cuenta Resend).
CONTACT_FROM_EMAIL="Caissa <web@caissa.com.ar>"

# Casilla que recibe las consultas del formulario.
CONTACT_TO_EMAIL=hola@caissa.com.ar
